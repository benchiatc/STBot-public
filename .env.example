# Copy to .env for local use, or set these in Heroku Config Vars.
# Each deployment must use its own bot, database credentials, and API key.
BOT_TOKEN=
MONGODB_URI=
OPENAI_API_KEY=
# The HTTPS origin shown by `heroku apps:info`; no trailing path.
PUBLIC_BASE_URL=
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Optional defaults:
OPENAI_MODEL=gpt-5-mini
ARTICLE_DATABASE=st_articles
USER_DATABASE=user_base
NOTIFICATIONS_ENABLED=true
# Restricts /seecurrentusers; leave empty to disable that command for everyone.
ADMIN_USER_IDS=
